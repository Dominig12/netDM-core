BLUEMOON_SOURCE=./source
BLUEMOON_IMAGE_PREFIX=netdm-local/bluemoon
BLUEMOON_RELEASE=p1
BLUEMOON_BIND_ADDRESS=127.0.0.1
BLUEMOON_PORT=1337
BLUEMOON_SERVER_ID=bluemoon
BLUEMOON_DB_PASSWORD_FILE=./secrets/db-password
BLUEMOON_DB_ROOT_PASSWORD_FILE=./secrets/db-root-password
# P13 (optional): network life and immersion; 0 keeps the ordinary deployment.
NETDM_NET_LIFE=0
NETDM_NET_IMMERSION=0
